# ==============================================================================
# FieldSure AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# WARNING: NEVER commit the '.env' file or expose real API keys in version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Member 1 & Member 3)
# ------------------------------------------------------------------------------
# Base URL for the LLM API provider (OpenAI, OpenRouter, Local vLLM/Ollama, etc.)
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Local Ollama: http://localhost:11434/v1
API_BASE_URL=https://api.openai.com/v1

# Authentication API Key
API_KEY=your_llm_api_key_here

# Target chat completion model name
# Examples: gpt-4o-mini, mistralai/mistral-7b-instruct, llama3:8b
CHAT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Embeddings & Vector Database Configuration (Member 2)
# ------------------------------------------------------------------------------
# Target embedding model used for indexing and similarity search
# Examples: text-embedding-3-small, BAAI/bge-large-en-v1.5
EMBEDDING_MODEL=text-embedding-3-small

# Vector database local storage path or remote connection URL
# Examples:
#   Local ChromaDB/FAISS path: data/vectordb
#   Remote Qdrant/Milvus URL:  http://localhost:6333
VECTOR_DB_PATH=data/vectordb
VECTOR_DB_URL=
VECTOR_DB_COLLECTION=fieldsure_chunks

# ------------------------------------------------------------------------------
# Ingestion & Chunking Parameters (Member 1)
# ------------------------------------------------------------------------------
# Target maximum token window per chunk
CHUNK_TOKEN_SIZE=500

# Overlap tokens between adjacent chunks
CHUNK_TOKEN_OVERLAP=50
